# ============================================================
# 部署到 GitHub / Render 时**不需要**上传的东西
# 目的：把 242MB 压到 ~175MB，国内上传才跑得动
# ============================================================

# ---- 依赖 ----
node_modules/
npm-debug.log*

# ---- 开发中间产物（生成图、截图、原始素材）----
# dev/ 下的 .js 测试脚本要保留（npm test 用），只排除这些大件
dev/_gen/
dev/_shots/
dev/_raw/

# ---- 旧版贴图 ----
# 游戏只读 art/v9/（index.html 与 src/ 里 29 处引用全是 v9），
# v3–v8 是历史迭代留下的，占 12MB，不参与运行。
art/v3/
art/v4/
art/v5/
art/v6/
art/v8/

# ---- 系统 / 编辑器 ----
.DS_Store
Thumbs.db
desktop.ini
*.swp
*~

# ---- 日志与临时文件 ----
*.log
*.tmp
